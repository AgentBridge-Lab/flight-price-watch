# 이 파일을 ~/.config/flight-price-watch/.env 로 복사해서 채우세요.
# 다른 경로를 쓰려면 FLIGHT_WATCH_ENV_FILE 환경변수나 --secrets-path 를 지정하면 됩니다.

# --- 방법 A: 텔레그램 봇 직접 사용 (--notify telegram) ---
# @BotFather 에서 봇을 만들어 토큰을 받고,
# 그 봇에게 아무 메시지나 보낸 뒤 아래 주소에서 chat id 를 확인하세요.
#   https://api.telegram.org/bot<토큰>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 방법 B: OpenClaw 경유 (--notify openclaw) ---
# 이미 OpenClaw 를 쓰고 있다면 별도 봇 토큰 없이 보낼 수 있습니다.
OPENCLAW_NOTIFY_TARGET=telegram:YOUR_CHAT_ID
OPENCLAW_NOTIFY_CHANNEL=telegram
OPENCLAW_NOTIFY_ACCOUNT=default
OPENCLAW_BIN=openclaw
